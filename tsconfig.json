{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["registry/ui/*"],
      "@/lib/*": ["registry/lib/*"],
      "nullfuse-core/motion": ["packages/core/src/motion.ts"],
      "nullfuse-core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["registry", "packages/core/src", "apps/docs/src"]
}
